# Настройки Docker Compose. Файл необязателен: без него действуют эти же
# значения по умолчанию. Чтобы что-то поменять:
#
#   cp .env.example .env
#
# Docker Compose и Makefile читают .env из корня проекта сами.

# --- Порты на вашей машине (поменяйте, если заняты) ---

# Интерфейс и API: http://localhost:8080, документация API — /api/docs
WEB_PORT=8080
# PostgreSQL снаружи контейнера (внутри сети Compose — всегда 5432)
DB_PORT=5433

# --- PostgreSQL 17 ---
# Учётные данные только для локального прототипа.

POSTGRES_DB=checkstock
POSTGRES_USER=checkstock
POSTGRES_PASSWORD=checkstock
