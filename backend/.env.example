# Настройки бэкенда при запуске БЕЗ Docker (uvicorn, alembic, pytest с машины).
# В Docker этот файл не используется: DATABASE_URL задаёт docker-compose.yml.
#
#   cp .env.example .env

# Формат: postgresql+asyncpg://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/БАЗА
# Значение ниже подходит к базе из Docker Compose (порт DB_PORT=5433).
# Для своей PostgreSQL подставьте её пользователя, пароль и порт (обычно 5432).
# Тесты сами создают соседнюю базу с суффиксом _test (checkstock_test).
DATABASE_URL=postgresql+asyncpg://checkstock:checkstock@localhost:5433/checkstock
